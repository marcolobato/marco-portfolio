          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Display/Medium · --text-5xl · 56px</span>
            <p style="font-family: var(--font-display); font-size: var(--text-5xl); font-weight: var(--weight-bold); line-height: var(--leading-tight); color: var(--color-heading); margin: 0;">Display Medium</p>
          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Display/Small · --text-4xl · 40px</span>
