                <!-- Outline variant — transparent bg with a 2px border -->
                <Card variant="outline" padding="lg" style="width: 220px;">
                  <CardHeader>
                    <BasisText variant="card-title">Outline card</BasisText>
                    <BasisText variant="card-subtitle">Border only, no fill</BasisText>
                  </CardHeader>
                  <CardContent>
                    <BasisText variant="card-description">Background is transparent. Uses <code>--border</code> for its edge.</BasisText>
                  </CardContent>
                  <CardFooter>
                    <BasisButton size="sm" variant="outline">Action</BasisButton>
                  </CardFooter>
                </Card>

              </div>
            </div>


            <!-- ── DIVIDER ──────────────────────────────────────────────── -->
            <div class="sg-gallery-block" id="basis-divider">
              <p class="sg-gallery-block-title">Divider — <code>src/components/ui/layout/Divider.astro</code></p>
              <p class="sg-gallery-block-status sg-gallery-block-status--unused">Available, not currently in use.</p>
              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: 0 0 var(--space-md);">
                Always uses <code>--border</code> — flips automatically in dark mode.
                No accent variant in the component; use a wrapper with a colored background for accent rules.
              </p>

              <!-- Thin (default) -->
              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: 0 0 var(--space-xs);">thickness="1" (default)</p>
              <BasisText variant="muted">Content above</BasisText>
              <Divider spacing="2" />
              <BasisText variant="muted">Content below</BasisText>

              <!-- Thick -->
              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: var(--space-lg) 0 var(--space-xs);">thickness="4"</p>
              <BasisText variant="muted">Content above</BasisText>
              <Divider spacing="2" thickness="4" />
              <BasisText variant="muted">Content below</BasisText>

              <!-- Vertical -->
              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: var(--space-lg) 0 var(--space-xs);">direction="vertical" (needs a flex-row parent)</p>
              <div style="display: flex; align-items: center; height: 40px;">
                <BasisText variant="body">Left content</BasisText>
                <Divider direction="vertical" spacing="4" />
                <BasisText variant="body">Right content</BasisText>
              </div>
            </div>


            <!-- ── NAVBAR ───────────────────────────────────────────────── -->
            <div class="sg-gallery-block" id="basis-navbar">
              <p class="sg-gallery-block-title">Navbar — <code>src/components/ui/display/Navbar.astro</code></p>
              <p class="sg-gallery-block-status sg-gallery-block-status--unused">Available, not currently in use (the site nav is a custom Astro component).</p>
              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: 0 0 var(--space-md);">
                Uses <code>sticky={false}</code> here so it doesn't float over the page.
                In production, the default <code>sticky={true}</code> pins it to the top with a blur backdrop.
                Background is <code>bg-background/95</code> — semi-transparent, adapts to dark mode.
              </p>
              <!-- overflow: hidden clips the sticky positioning inside the preview box -->
              <div style="border: 1px solid hsl(var(--border)); border-radius: 6px; overflow: hidden;">
                <BasisNavbar sticky={false}>
                  <span slot="brand" style="font-weight: 700; font-size: var(--text-base); color: hsl(var(--foreground));">Marco Lobato</span>
                  <div slot="links" style="display: flex; gap: var(--space-lg);">
                    <a href="/#work" class="text-sm text-muted-foreground hover:text-primary transition-colors duration-150">Work</a>
                    <a href="/writing" class="text-sm text-primary font-medium transition-colors duration-150">Writing</a>
                    <a href="/#about" class="text-sm text-muted-foreground hover:text-primary transition-colors duration-150">About</a>
                  </div>
                  <BasisButton slot="actions" size="sm" variant="outline">Contact</BasisButton>
                </BasisNavbar>
