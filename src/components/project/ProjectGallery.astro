---
// ProjectGallery.astro — Stripped-down image carousel for project pages.
//
// Reuses the same .carousel CSS classes as the home page Carousel.astro
// (defined in src/styles/global.css section 16), so it inherits the slide
// card, 3:2 image area, arrow buttons, and dot pagination for free.
//
// Differences from the home Carousel:
//   - Slides are passed in as a prop (no hardcoded array).
//   - No per-slide title/subtitle overlay or link CTA — just an image.
//   - One shared caption renders below the carousel as italic text,
//     matching the inline-image caption pattern used elsewhere in MDX.
//
// Usage in MDX (inside src/content/projects/*.mdx):
//
//   import ProjectGallery from '../../components/project/ProjectGallery.astro';
//
//   <ProjectGallery
//     slides={[
//       { image: "/projects/foo/img-1.png", alt: "Screen 1" },
//       { image: "/projects/foo/img-2.png", alt: "Screen 2" },
//     ]}
//     caption="App design screenshots."
//     ariaLabel="App design screenshots"
//   />
//
// Notes:
//   - Multiple ProjectGallery instances on the same page work independently —
//     the script below selects every .carousel and initializes each one.
//   - Astro dedupes identical <script> blocks across components, so this
//     script ships once even if both Carousel and ProjectGallery are used.

interface Slide {
  image: string;
  alt:   string;
}

interface Props {
  slides:    Slide[];
  caption?:  string;
  ariaLabel: string;
  // "contain" (default): letterbox the image inside the slide box.
  // "cover": fill the slide and crop the bottom of the image.
  fit?:      "contain" | "cover";
  // Override the default 3/2 slide aspect ratio. Pass a CSS aspect-ratio
  // string like "1080 / 886" when the gallery images use a different shape
  // and you want the slide to match exactly so nothing crops.
  aspectRatio?: string;
}

const { slides, caption, ariaLabel, fit = "contain", aspectRatio } = Astro.props;
const fitClass = fit === "cover" ? "carousel--cover" : "carousel--fit";
// Apply aspect-ratio to the SLIDE wrapper, not the image. This pins the slide
// shape so all 3 slides are the same height regardless of each image's
// natural dimensions (e.g. a portrait mobile screenshot mixed with landscape
// web/car screenshots). The image then fills the slide via object-fit.
const slideStyle = aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined;
---

<div class={`carousel ${fitClass}`} aria-roledescription="carousel" aria-label={ariaLabel}>

  <div class="carousel-viewport">
    <div class="carousel-track">

      {slides.map((slide, i) => (
        <div
          class="carousel-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}: ${slide.alt}`}
          style={slideStyle}
        >
          <img src={slide.image} alt={slide.alt} class="carousel-slide-image" />
        </div>
      ))}

    </div>
  </div>

  <div class="carousel-controls">

    <div class="carousel-arrows">
      <button class="carousel-btn carousel-btn--prev" aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="carousel-btn carousel-btn--next" aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="carousel-dots" role="tablist" aria-label="Go to slide">
      {slides.map((slide, i) => (
        <button
          class={`carousel-dot${i === 0 ? ' carousel-dot--active' : ''}`}
          role="tab"
          aria-label={`Slide ${i + 1}: ${slide.alt}`}
          aria-selected={i === 0 ? "true" : "false"}
          data-index={String(i)}
        ></button>
      ))}
    </div>

  </div>
</div>

{caption && <p class="project-gallery-caption"><em>{caption}</em></p>}


<script>
  // Same interaction pattern as Carousel.astro. Selects every .carousel on
  // the page and initializes each one independently, so multiple galleries
  // (or a gallery + the home Carousel) coexist without conflict.
  document.querySelectorAll('.carousel').forEach((carousel) => {
    const track   = carousel.querySelector('.carousel-track') as HTMLElement;
    const prevBtn = carousel.querySelector('.carousel-btn--prev') as HTMLButtonElement;
    const nextBtn = carousel.querySelector('.carousel-btn--next') as HTMLButtonElement;
    const dots    = carousel.querySelectorAll('.carousel-dot') as NodeListOf<HTMLButtonElement>;

    let currentIndex = 0;
    const total = dots.length;

    function goToSlide(index: number) {
      currentIndex = ((index % total) + total) % total;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, i) => {
        const isActive = i === currentIndex;
        dot.classList.toggle('carousel-dot--active', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i)));

    carousel.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      if (keyEvent.key === 'ArrowLeft')  { goToSlide(currentIndex - 1); keyEvent.preventDefault(); }
      if (keyEvent.key === 'ArrowRight') { goToSlide(currentIndex + 1); keyEvent.preventDefault(); }
    });
  });
</script>


<style>
  /* Caption sits below the carousel and matches the italic inline-image
     caption pattern used elsewhere in project body content.
     max-width: none overrides the global p { max-width: 65ch } cap so the
     caption spans the full carousel width and text-align: center actually
     centers under the carousel at every viewport size. */
  .project-gallery-caption {
    max-width: none;
    text-align: center;
    color: var(--color-charcoal);
    font-size: var(--text-sm);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  /* .carousel--fit modifier: fit the whole image inside the 3:2 slide box
     instead of cropping it to fill. :global() is required because the slide
     image markup comes from the same component but Astro's scoped CSS only
     applies to elements declared in this file's template — using :global()
     makes the rule reach the .carousel-slide-image children regardless of
     where they end up in the rendered DOM.
     The slide card background fills any letterboxed space around the image. */
  .carousel--fit :global(.carousel-slide-image) {
    object-fit: contain;
  }

  /* When the slide has an explicit aspect-ratio (from the aspectRatio prop),
     make the image fill the slide instead of computing its own height from
     the global .carousel-slide-image aspect-ratio. Without this, the image
     gets its own 3:2 height, which may not match the slide's height and
     leaves a white band inside the slide. */
  :global(.carousel-slide[style*="aspect-ratio"]) > :global(.carousel-slide-image) {
    height: 100%;
    aspect-ratio: auto;
  }

  /* .carousel--cover modifier: fill the slide box and crop the top of the
     image. object-position: bottom anchors the bottom edge so any cropping
     happens at the top, which leaves the bottom of the screenshot fully in
     view and pushes any letterbox/empty space to the bottom of the slide. */
  .carousel--cover :global(.carousel-slide-image) {
    object-fit: cover;
    object-position: bottom;
  }
</style>
