---
// =============================================================================
// AuditBadge — anonymized port of the client's Badge component.
// Used only by src/pages/badge-audit.astro to recreate the original POC.
// Color tokens come from src/styles/badge-audit-tokens.css (--audit-* prefix).
//
// SHARED STYLES (all variants):
//   font:          Inter 500, 14px, 20px line-height
//   border-radius: 16px (rounded-2xl)
//   padding:       4px top/bottom, 12px left/right (py-1 px-3)
//   border:        1px solid
//
// VARIANT STRUCTURE:
//   Each Pill color variant follows the 50/200/700 color scale:
//     background → color/50, border → color/200, text → color/700
//
// FLAGGED DUPLICATES (kept as separate variants for the audit's review):
//   - "orange"     = identical tokens to "warning"
//   - "blue-light" = identical tokens to "blue"
// =============================================================================

import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const badgeVariants = cva(
  // Base styles shared by every variant.
  "inline-flex items-center rounded-2xl border px-3 py-1 text-sm leading-5 font-medium whitespace-nowrap",
  {
    variants: {
      variant: {
        gray:        "bg-[var(--audit-gray-50)] border-[var(--audit-gray-200)] text-[var(--audit-gray-700)]",
        blue:        "bg-[var(--audit-primary-50)] border-[var(--audit-primary-200)] text-[var(--audit-primary-700)]",
        indigo:      "bg-[var(--audit-indigo-50)] border-[var(--audit-indigo-200)] text-[var(--audit-indigo-700)]",
        purple:      "bg-[var(--audit-purple-50)] border-[var(--audit-purple-200)] text-[var(--audit-purple-700)]",
        pink:        "bg-[var(--audit-pink-50)] border-[var(--audit-pink-200)] text-[var(--audit-pink-700)]",
        error:       "bg-[var(--audit-error-50)] border-[var(--audit-error-200)] text-[var(--audit-error-700)]",
        warning:     "bg-[var(--audit-warning-50)] border-[var(--audit-warning-200)] text-[var(--audit-warning-700)]",
        // Duplicate of warning — kept separate because the original system listed both
        orange:      "bg-[var(--audit-warning-50)] border-[var(--audit-warning-200)] text-[var(--audit-warning-700)]",
        success:     "bg-[var(--audit-success-50)] border-[var(--audit-success-200)] text-[var(--audit-success-700)]",
        // Mixed-scale variant: white bg, gray border, indigo text
        "gray-blue": "bg-[var(--audit-base-white)] border-[var(--audit-gray-200)] text-[var(--audit-indigo-700)]",
        // Duplicate of blue — kept separate for the same reason as orange
        "blue-light": "bg-[var(--audit-primary-50)] border-[var(--audit-primary-200)] text-[var(--audit-primary-700)]",
        // Differs from Pill: white background, stronger border (300), drop shadow
        "badge-modern": "bg-[var(--audit-base-white)] border-[var(--audit-gray-300)] text-[var(--audit-gray-700)] shadow-[var(--audit-shadow-xs)]",
      },
    },
    defaultVariants: {
      variant: "gray",
    },
  }
);

interface Props extends VariantProps<typeof badgeVariants> {
  class?: string;
}

const { variant, class: className } = Astro.props;
---

<span class={cn(badgeVariants({ variant }), className)}>
  <slot />
</span>
