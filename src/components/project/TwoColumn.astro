---
// TwoColumn.astro — Two-column layout pairing prose with a single image.
//
// Used for case study sections that benefit from a side-by-side reading
// rhythm: text on one side, supporting image on the other.
//
// Behavior:
//   Desktop (>= 768px): two equal columns. Image on the side specified by
//     `imagePosition`. Default is "right".
//   Mobile (< 768px): stacks to a single column. Text first, image second
//     (regardless of imagePosition).
//
// The image and caption use the same <img> + <em> markup pattern that
// markdown produces for `![alt](src)\n*caption*`, so the existing
// `.project-body img + em` rules in src/pages/work/[slug].astro give
// the caption identical styling to inline images elsewhere on the page.
//
// Usage in MDX:
//
//   import TwoColumn from '../../components/project/TwoColumn.astro';
//
//   <TwoColumn
//     image="/projects/voice-access/va-why-dictation.png"
//     imageAlt="Dictation on phone keyboard"
//     imageCaption="Caption text..."
//     imagePosition="right"
//   >
//     Markdown body content goes here as children.
//   </TwoColumn>

interface Props {
  image:          string;
  imageAlt:       string;
  imageCaption?:  string;
  imagePosition?: 'left' | 'right';
}

const {
  image,
  imageAlt,
  imageCaption,
  imagePosition = 'right',
} = Astro.props;
---

<section class={`tc tc--image-${imagePosition}`}>
  <div class="tc-text">
    <slot />
  </div>
  <p class="tc-figure">
    <img src={image} alt={imageAlt} />
    {imageCaption && <em>{imageCaption}</em>}
  </p>
</section>

<style>
  .tc {
    display: grid;
    gap: var(--space-xl);
    margin-block: var(--space-2xl);
    align-items: start;
  }

  /* Desktop: two equal columns. */
  @media (min-width: 768px) {
    .tc {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
    }
    /* Reverse visual order so image lands on the left when requested.
       Mobile order stays text-first regardless of imagePosition. */
    .tc--image-left .tc-figure {
      order: -1;
    }
  }

  /* The default `.project-body img` rule (in work/[slug].astro) adds a top
     margin between stacked body elements. Inside the column the grid gap
     already handles separation, so reset to 0. */
  .tc-figure {
    margin: 0;
  }
  .tc-figure :global(img) {
    margin-top: 0;
  }

  /* `.project-body img + em` from the page template adds a bottom margin
     after captions to space them from the next paragraph. Inside this
     column there is no following paragraph, so reset to 0. */
  .tc-figure :global(em) {
    margin-bottom: 0;
  }

  /* Strip the top margin on the first child of the text column so the
     prose starts flush with the top of the image, not pushed down by a
     default heading or paragraph margin. */
  .tc-text :global(> :first-child) {
    margin-top: 0;
  }
</style>
