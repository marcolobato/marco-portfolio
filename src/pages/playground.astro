            <!-- ── BADGE ────────────────────────────────────────────────── -->
            <div class="sg-gallery-block" id="basis-badge">
              <p class="sg-gallery-block-title">Badge — <code>src/components/ui/feedback/Badge.astro</code></p>
              <p class="sg-gallery-block-status sg-gallery-block-status--used">Used in Field Note cards for tool labels.</p>
              <div class="sg-gallery-row">
                <!-- default: bg-primary (navy) -->
                <Badge>Default</Badge>
                <!-- secondary: bg-secondary (navy-100) -->
                <Badge variant="secondary">Secondary</Badge>
                <!-- destructive: bg-destructive -->
                <Badge variant="destructive">Destructive</Badge>
                <!-- outline: border-border, transparent bg -->
                <Badge variant="outline">Outline</Badge>
