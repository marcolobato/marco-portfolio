---
// =============================================================================
// BackLink — single shared back-navigation link used across the site.
//
// Replaces three legacy implementations (.post-back on article pages,
// .project-back on work case studies, .audit-back / .pg-back on the badge
// audit and playground pages). One markup, one style, one source of truth.
//
// Visual style lives in src/styles/global.css under `.back-link`. SVG
// arrow (14×14) sized to match the text height; border-bottom underline
// on hover that extends across the entire link including the arrow.
//
// Props:
//   href    — destination URL (or "#" placeholder when JS will set it)
//   label   — text shown after the arrow (default "Back")
//   hidden  — when true, renders with the HTML hidden attribute (used by
//             the playground's referrer-aware variant; an inline script
//             unhides it after checking document.referrer)
//   class   — extra class applied alongside .back-link (used by the
//             playground's inline script to target the element)
// =============================================================================

interface Props {
  href:    string;
  label?:  string;
  hidden?: boolean;
  class?:  string;
}

const {
  href,
  label = "Back",
  hidden,
  class: className,
} = Astro.props;
---

<a
  href={href}
  hidden={hidden}
  class:list={["back-link", className]}
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 12H5M12 19l-7-7 7-7" />
  </svg>
  <span>{label}</span>
</a>
