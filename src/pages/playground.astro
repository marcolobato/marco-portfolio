          <div class="sg-type-row">
            <span class="sg-type-meta">Heading/H1 · Bold · --text-3xl · 32px</span>
            <p style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: var(--weight-bold); line-height: var(--leading-tight); color: var(--color-heading); margin: 0;">Heading H1</p>
          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Heading/H2 · Bold · --text-2xl · 24px</span>
            <p style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--weight-bold); line-height: var(--leading-tight); color: var(--color-heading); margin: 0;">Heading H2</p>
          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Heading/H3 · SemiBold · --text-xl · 20px</span>
            <p style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--color-heading); margin: 0;">Heading H3</p>
          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Heading/H4 · SemiBold · --text-lg · 18px</span>
            <p style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--color-heading); margin: 0;">Heading H4</p>
          </div>
        </div>

        <h3 class="sg-subsection-title" id="type-body" style="margin-top: var(--space-2xl);">Body · Geist Regular</h3>
        <div class="sg-type-scale">
          <div class="sg-type-row">
            <span class="sg-type-meta">Body/Large · --text-lg · 18px</span>
            <p style="font-size: var(--text-lg); margin: 0;">Body Large, for lead paragraphs and intros.</p>
          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Body/Base · --text-base · 16px</span>
            <p style="margin: 0;">Body Base, the default reading text. Measure stays near 65ch for comfortable line length.</p>
          </div>
          <div class="sg-type-row">
            <span class="sg-type-meta">Body/Small · --text-sm · 14px</span>
            <p style="font-size: var(--text-sm); margin: 0;">Body Small, for secondary and supporting copy.</p>
          </div>
        </div>

        <!-- ── Labels & mono ───────────────────────────────────────────
             The label and monospace styles, kept in parity with the Figma
