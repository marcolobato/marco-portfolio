      <!-- ===================================================================
           SECTION: SPACING
           A 9-step scale from 4px to 96px. The visual bars in the table show
           each step at actual size so the relative jumps are visible at a
           glance. Tokens defined in src/styles/global.css.
           =================================================================== -->
      <section class="sg-section" id="spacing">
        <h2 class="sg-section-title">Spacing</h2>
        <p class="sg-section-desc">
          Use for padding, margins, and gaps. A 9-step scale from 4px to 96px.
        </p>

        <!-- Spacing scale table. The .sg-spacing-bar div on each row has an
             inline width matching that step's actual size — so a reader sees
             real proportions without needing to compute them. -->
        <div class="sg-spacing-scale">
          <table class="sg-spacing-table">
            <thead>
              <tr>
                <th>Token</th>
                <th>rem</th>
                <th>px</th>
                <th>Visual</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><code>--space-2xs</code></td><td>0.25rem</td><td>4px</td>  <td><span class="sg-spacing-bar" style="width: 0.25rem;"></span></td></tr>
              <tr><td><code>--space-xs</code></td> <td>0.5rem</td> <td>8px</td>  <td><span class="sg-spacing-bar" style="width: 0.5rem;"></span></td></tr>
              <tr><td><code>--space-sm</code></td> <td>0.75rem</td><td>12px</td> <td><span class="sg-spacing-bar" style="width: 0.75rem;"></span></td></tr>
              <tr><td><code>--space-md</code></td> <td>1rem</td>   <td>16px</td> <td><span class="sg-spacing-bar" style="width: 1rem;"></span></td></tr>
              <tr><td><code>--space-lg</code></td> <td>1.5rem</td> <td>24px</td> <td><span class="sg-spacing-bar" style="width: 1.5rem;"></span></td></tr>
              <tr><td><code>--space-xl</code></td> <td>2rem</td>   <td>32px</td> <td><span class="sg-spacing-bar" style="width: 2rem;"></span></td></tr>
              <tr><td><code>--space-2xl</code></td><td>3rem</td>   <td>48px</td> <td><span class="sg-spacing-bar" style="width: 3rem;"></span></td></tr>
              <tr><td><code>--space-3xl</code></td><td>4.5rem</td> <td>72px</td> <td><span class="sg-spacing-bar" style="width: 4.5rem;"></span></td></tr>
              <tr><td><code>--space-4xl</code></td><td>6rem</td>   <td>96px</td> <td><span class="sg-spacing-bar" style="width: 6rem;"></span></td></tr>
            </tbody>
          </table>
        </div>
      </section>


      <!-- ===================================================================
           SECTION: PRIMITIVES
           The smallest reusable building blocks. Button is documented in full
           depth (anatomy, variants, states, properties, tokens, usage notes)
           as the exemplar; SectionLabel and BackLink follow the same template
           in shorter form because they have fewer variants/states to show.
           =================================================================== -->
      <section class="sg-section" id="primitives">
        <h2 class="sg-section-title">Primitives</h2>
        <p class="sg-section-desc">
          The smallest reusable building blocks: standalone actions and inline labels.
        </p>

        <!-- ── Button ──────────────────────────────────────────────────── -->
        <ComponentDoc
          id="doc-button"
          name="Button"
          status="Stable"
          purpose="Triggers an action or navigates to a destination."
          tokens={["--color-navy", "--color-lemon", "--color-surface", "--color-charcoal"]}
        >
          <Fragment slot="anatomy">
            <Button label="Label" href="#" />
          </Fragment>

          <Fragment slot="variants">
            <div style="display: flex; gap: var(--space-md); flex-wrap: wrap; align-items: center;">
              <Button label="Primary" href="#" variant="primary" />
              <Button label="Secondary" href="#" variant="secondary" />
              <Button
                label="With icon"
                variant="secondary"
                icon='<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>'
              />
            </div>
          </Fragment>

          <Fragment slot="states">
            <div style="display: flex; gap: var(--space-md); flex-wrap: wrap; align-items: center;">
              <Button label="Default" href="#" variant="primary" />
              <Button label="Disabled" href="#" variant="primary" disabled />
            </div>
          </Fragment>

          <Fragment slot="properties">
            <table>
              <thead>
                <tr><th>Name</th><th>Type</th><th>Default</th><th>Notes</th></tr>
              </thead>
              <tbody>
                <tr><td><code>label</code></td><td><code>string</code></td><td>required</td><td>Visible button text.</td></tr>
                <tr><td><code>href</code></td><td><code>string</code></td><td>—</td><td>When set, renders as <code>&lt;a&gt;</code>; otherwise renders as <code>&lt;button&gt;</code>.</td></tr>
                <tr><td><code>variant</code></td><td><code>"primary" | "secondary"</code></td><td><code>"primary"</code></td><td>Visual style.</td></tr>
                <tr><td><code>disabled</code></td><td><code>boolean</code></td><td><code>false</code></td><td>Greys out and prevents interaction.</td></tr>
                <tr><td><code>icon</code></td><td><code>string</code></td><td>—</td><td>Raw SVG string rendered on the left; replaces the right arrow.</td></tr>
                <tr><td><code>external</code></td><td><code>boolean</code></td><td><code>false</code></td><td>Adds <code>target="_blank"</code> and safe rel attributes for off-site links.</td></tr>
                <tr><td><code>download</code></td><td><code>boolean</code></td><td><code>false</code></td><td>Triggers a file save instead of navigation.</td></tr>
              </tbody>
            </table>
          </Fragment>

          <Fragment slot="usage">
            <ul>
              <li>Use <strong>primary</strong> for the main action on a page. One per section.</li>
              <li>Use <strong>secondary</strong> for supporting actions. Multiple per section is fine.</li>
              <li>Pass <code>href</code> when the button navigates somewhere; omit it when the button triggers an action in place.</li>
              <li>Pass <code>external</code> when the link leaves the site.</li>
            </ul>
          </Fragment>

          <Fragment slot="code">
            <pre><code>{`<Button label="Primary" href="/work" />
<Button label="Secondary" href="/about" variant="secondary" />
<Button label="External" href="https://example.com" external />
<Button label="Resume" href="/resume.pdf" download />`}</code></pre>
          </Fragment>
        </ComponentDoc>


        <!-- ── Section Label ───────────────────────────────────────────── -->
        <ComponentDoc
          id="doc-section-label"
          name="Section Label"
          status="Stable"
          purpose="Introduces a major section with a small lemon pill."
          tokens={["--color-lemon", "--color-navy"]}
        >
          <Fragment slot="anatomy">
            <SectionLabel label="Selected Work" />
          </Fragment>

          <Fragment slot="properties">
            <table>
              <thead>
                <tr><th>Name</th><th>Type</th><th>Default</th><th>Notes</th></tr>
              </thead>
              <tbody>
                <tr><td><code>label</code></td><td><code>string</code></td><td>required</td><td>Pill text. Keep it short (1 to 3 words).</td></tr>
              </tbody>
            </table>
          </Fragment>

          <Fragment slot="usage">
            <ul>
              <li>Use as the introduction to a major section, above the section heading.</li>
              <li>Lemon is reserved for this purpose at full saturation. It feels like a signal because it appears nowhere else.</li>
            </ul>
          </Fragment>

          <Fragment slot="code">
            <pre><code>{`<SectionLabel label="Selected Work" />`}</code></pre>
          </Fragment>
        </ComponentDoc>


        <!-- ── Back Link ────────────────────────────────────────────── -->
        <ComponentDoc
          id="doc-back-link"
          name="Back Link"
          status="Stable"
          purpose="Returns the visitor to the previous page."
          tokens={["--color-royal-blue", "--color-heading"]}
        >
          <Fragment slot="anatomy">
            <BackLink href="#" />
          </Fragment>

          <Fragment slot="variants">
            <div style="display: flex; gap: var(--space-xl); flex-wrap: wrap; align-items: center;">
              <BackLink href="#" />
              <BackLink href="#" label="Back to work" />
            </div>
          </Fragment>

          <Fragment slot="properties">
            <table>
              <thead>
                <tr><th>Name</th><th>Type</th><th>Default</th><th>Notes</th></tr>
              </thead>
              <tbody>
                <tr><td><code>href</code></td><td><code>string</code></td><td>required</td><td>Destination URL. Use <code>"#"</code> as a placeholder when JavaScript will set it at runtime.</td></tr>
                <tr><td><code>label</code></td><td><code>string</code></td><td><code>"Back"</code></td><td>Text shown after the arrow.</td></tr>
                <tr><td><code>hidden</code></td><td><code>boolean</code></td><td><code>false</code></td><td>Renders with the HTML <code>hidden</code> attribute. Used for the referrer-aware variant on this page.</td></tr>
                <tr><td><code>class</code></td><td><code>string</code></td><td>—</td><td>Extra class applied alongside <code>.back-link</code>. Useful as a JS hook.</td></tr>
              </tbody>
            </table>
          </Fragment>

          <Fragment slot="usage">
            <ul>
              <li>Place at the top of a page that's reached from a parent page (a work case study, a writing article, the playground).</li>
              <li>Use the default <code>"Back"</code> label most of the time. Override only when the parent context is ambiguous.</li>
            </ul>
          </Fragment>

          <Fragment slot="code">
            <pre><code>{`<BackLink href="/work" />
<BackLink href="/work" label="Back to work" />`}</code></pre>
          </Fragment>
        </ComponentDoc>
      </section>


      <!-- ===================================================================
           SECTION: CARDS
           Content-bearing surfaces. ProjectCard is the simplest (image plus
           title); FieldNoteCard, WritingCard, and WorkCard add more structure
           for richer use cases. Each card uses generic placeholder content so
           the anatomy is readable independent of the real portfolio data.
           =================================================================== -->
      <section class="sg-section" id="cards">
        <h2 class="sg-section-title">Cards</h2>
        <p class="sg-section-desc">
          Content-bearing surfaces. Use for grids of work, writing, or field notes.
        </p>

        <!-- ── Project Card ────────────────────────────────────────────── -->
        <ComponentDoc
          id="doc-project-card"
          name="Project Card"
          status="Stable"
          purpose="Displays a project as an image with a title beneath."
          tokens={["--color-surface", "--color-charcoal", "--color-heading"]}
        >
          <Fragment slot="anatomy">
            <div style="max-width: 320px;">
              <ProjectCard title="Project title" image="/images/playground-placeholder.svg" />
            </div>
          </Fragment>

          <Fragment slot="variants">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); max-width: 640px;">
              <ProjectCard title="With image" image="/images/playground-placeholder.svg" />
              <ProjectCard title="No image (placeholder)" />
            </div>
          </Fragment>

          <Fragment slot="properties">
            <table>
              <thead>
                <tr><th>Name</th><th>Type</th><th>Default</th><th>Notes</th></tr>
              </thead>
              <tbody>
                <tr><td><code>title</code></td><td><code>string</code></td><td>required</td><td>Card heading shown below the image.</td></tr>
                <tr><td><code>image</code></td><td><code>string</code></td><td>—</td><td>Image src. When omitted, a placeholder appears.</td></tr>
              </tbody>
            </table>
          </Fragment>

          <Fragment slot="usage">
            <ul>
              <li>Use in a flex row to display multiple projects side by side.</li>
              <li>Omit the image only during development or when the project doesn't have a cover yet.</li>
            </ul>
          </Fragment>

          <Fragment slot="code">
            <pre><code>{`<ProjectCard title="Project title" image="/images/work/project.png" />`}</code></pre>
          </Fragment>
        </ComponentDoc>


        <!-- ── Field Note Card ─────────────────────────────────────────── -->
        <ComponentDoc
          id="doc-field-note-card"
