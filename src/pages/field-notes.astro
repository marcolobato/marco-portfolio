---
// field-notes.astro: Field Notes archive page (URL: /field-notes)
// Renamed from experiments.astro. The old /experiments URL still works
// thanks to a 301 redirect in public/_redirects.
//
// Sections, top to bottom:
//   1. Header (page title + description)
//   2. Multimodal work — featured experiments shown with FieldNoteCard
//   3. Past entries — older Medium articles
//   4. Design concept glossary — terms + one-line definitions
import '../styles/global.css';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FieldNoteCard from '../components/FieldNoteCard.astro';

// All writing posts — fetched once, reused across both sections below.
const allPosts = await getCollection('writing');

// ── Multimodal work — featured experiments ────────────────────────────────
// Order is MANUAL (no date sort). Whatever order is in this array is the
// order the cards appear on the page. To reorder cards, just rearrange the
// strings below (or move/insert the inline `briefcase` entry further down).
const multimodalIds = ['ai-broken-in-denim', 'pharmassist', 'privacysim'];

// Helper — convert a writing collection entry into props for FieldNoteCard.
// Falls back to safe empty values if the optional frontmatter fields are
// missing, so a half-filled article still renders without erroring out.
const toCardProps = (post: any) => ({
  title: post.data.title,
  body: post.data.cardSummary ?? post.data.description ?? '',
  tools: post.data.tools ?? [],
  exploreHref: `/writing/${post.id}`,
  artifact: {
    image:   post.data.artifact?.image   ?? '',
    alt:     '', // decorative for now (PRD)
    caption: post.data.artifact?.caption ?? '',
    // Default link points at the article's #artifact anchor. Articles can
    // override this in frontmatter (artifact.href) to point elsewhere —
    // e.g. design-systems-explorations sends readers to /playground.
    href:    post.data.artifact?.href ?? `/writing/${post.id}#artifact`,
  },
});

// Walk the ordered ids and pull the matching post for each. .filter(Boolean)
// drops any id that didn't match a real post (defensive — stops the page
// from crashing if an id is misspelled).
const collectionCards = multimodalIds
  .map(id => allPosts.find(p => p.id === id))
  .filter(Boolean)
  .map(toCardProps);

// Marco's Briefcase — card 4. No article exists yet, so its data lives
// here inline. When the article is written, move this into the writing
// collection, add the slug to multimodalIds above, and delete this object.
// Until then, exploreHref and artifact.href are undefined so the card
// hides "Explore experiment" and renders the caption as plain text.
const briefcase = {
  title: "Marco's Briefcase: My WhatsApp Superagent",
  body: "I built a Base44 Superagent on WhatsApp that pulls my resume, work samples, and talking points based on a specific audience I define before a meeting. I learned how to build a Superagent and how to structure audience profiles as a filter for surfacing the right information in conversation.",
  tools: [{ label: 'Base44' }],
  exploreHref: undefined,
  artifact: {
    image:   '/images/field-notes/marcos-briefcase-artifact.png',
    alt:     '',
    caption: 'Screenshot of live agent on WhatsApp retrieving info at AI Builders Meetup',
    href:    undefined,
  },
};

// Final list rendered in the section. Collection cards first, briefcase last.
const multimodalCards = [...collectionCards, briefcase];

// ── Design systems ────────────────────────────────────────────────────────
// Field notes about design system audits, rebuilds, and token architecture
// explorations. Same FieldNoteCard component as Multimodal work above; order
// is manual — rearrange the strings to reorder the cards.
const designSystemsIds = ['design-systems-explorations'];
// Design systems cards surface component libraries on the badge row instead
// of tools, so we override the default "Tools:" label after building the
// standard card props. Section-level override — applies to every card here.
const designSystemsCards = designSystemsIds
  .map(id => allPosts.find(p => p.id === id))
  .filter(Boolean)
  .map(post => ({
    ...toCardProps(post),
    toolsLabel: 'Component libraries:',
    exploreLabel: 'Read more',
  }));

// ── Past entries ──────────────────────────────────────────────────────────
// Earlier writing on AI, design, and physical spaces. These are Medium
// articles ported into the writing collection; they live in Past entries
// (not Multimodal work) to keep the focus on current work.
const pastIds = ['ai-and-design-theory', 'digitizing-physical-spaces', 'learning-in-public'];
const pastEntries = allPosts
  .filter(post => pastIds.includes(post.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Field Notes — Marco Lobato"
  description="Documenting current work in multimodal AI interaction design. What I'm building, which tools I'm using, what I'm learning."
>

  <Nav />

  <main class="sg-main">

    <!-- ===================================================================
         PAGE HEADER
         =================================================================== -->
    <header class="sg-header" style="margin-bottom: var(--space-sm)">
      <p class="section-label">Explorations</p>
      <h1>Field Notes</h1>
      <div class="sg-header-sections">
        <div class="sg-header-section">
          <p class="sg-header-section-title">The full archive</p>
          <p class="sg-header-desc" style="max-width: 72ch;">Log of experiments in interaction design. Each entry documents what I built, what I used to build it, and what I learned. Most include an artifact: a prototype, a video, or something you can try.</p>
        </div>
      </div>
    </header>


    <!-- ===================================================================
         SECTION: DESIGN SYSTEMS
         Field notes about design system audits, rebuilds, and token
         architecture explorations. Uses the same FieldNoteCard component
         and .multimodal-cards layout class as the Multimodal work section
         below — the layout class is named after its first user, but it's
         a generic vertical card stack, not section-specific.
         padding-top: 0 because this is the FIRST section under the page
         header — without it, the section padding stacks on top of the
         header's bottom margin and the gap reads as too large.
         =================================================================== -->
    <section class="sg-section" id="design-systems" style="padding-top: 0;">

      <h2 style="margin-bottom: var(--space-md);">Design systems</h2>

      <p class="sg-header-desc" style="max-width: 72ch; margin-bottom: var(--space-xl);">
        I'm exploring how design systems can be documented to work as well for AI agents as they do for human designers.
      </p>

      <div class="multimodal-cards">
        {designSystemsCards.map(card => (
          <FieldNoteCard
            title={card.title}
            body={card.body}
            tools={card.tools}
            toolsLabel={card.toolsLabel}
            exploreHref={card.exploreHref}
            exploreLabel={card.exploreLabel}
            artifact={card.artifact}
          />
        ))}
      </div>

    </section>


    <!-- ===================================================================
         SECTION: MULTIMODAL WORK
         Featured experiments rendered with the FieldNoteCard component.
         Order is manual (see multimodalIds in the frontmatter above).
         Each card links to the article at /writing/{id} and to the
         #artifact anchor inside that article.
         =================================================================== -->
    <section class="sg-section" id="multimodal-work">

      <h2 style="margin-bottom: var(--space-md);">Multimodal work</h2>

      <p class="sg-header-desc" style="max-width: 72ch; margin-bottom: var(--space-xl);">
        I am evaluating tools to create AI agents and virtual humans powered by the latest AI models, with a focus on designing multimodal communication patterns. I'm interested in how these tools can facilitate more natural interactions between humans and technology.
      </p>

      <!-- Tagline directly above the card grid — labels the cards as the
           "tiny experiments" referenced in the description above. -->
      <p class="sg-header-section-title" style="margin-bottom: var(--space-md);">
        Interaction design experiments in multimodal AI
      </p>

      {/* Stack of FieldNoteCards — one per experiment. Each card is two
          columns wide (title + body on the left, image + caption on the
          right) and full-width within the section grid. See the scoped
          <style> block at the bottom of this file for the stack layout. */}
      <div class="multimodal-cards">
        {multimodalCards.map(card => (
          <FieldNoteCard
            title={card.title}
            body={card.body}
            tools={card.tools}
            exploreHref={card.exploreHref}
            artifact={card.artifact}
          />
        ))}
      </div>

      <!-- Sub-section of Multimodal work: a glossary of patterns surfaced
           across the experiments above. Uses h3 (one level under the section's
           h2) to signal this is part of Multimodal work, not a peer section.
           Styled by the scoped <style> block at the bottom of the file. -->
      <div class="glossary" style="margin-top: var(--space-2xl);">
        <h3 style="margin-bottom: var(--space-md);">Design concept glossary</h3>
        <p class="sg-header-desc" style="max-width: 72ch; margin-bottom: var(--space-lg);">
          Concepts named across the experiments above.
        </p>
        <dl>
          <dt>Deictic privacy</dt>
          <dd>Speaking in words that only resolve with shared context, using pronouns and spatial references ("that," "there," "it") instead of explicit details.</dd>

          <dt>Default-private</dt>
          <dd>Ensuring that sensitive details and personally identifiable information remain protected by making non-disclosure the standard setting.</dd>

          <dt>Channel splitting</dt>
          <dd>Strategically utilizing diverse communication paths to time and tailor content delivery, ensuring messages are optimized for the specific situation and audience.</dd>

          <dt>Show, don't speak</dt>
          <dd>In the context of conversation design, the "show, don't speak" principle utilizes visual aids to convey information. This approach keeps details private or provides necessary context by displaying the specific items or concepts under discussion, rather than relying solely on verbal explanation.</dd>

          <dt>Context-released information</dt>
          <dd>The strategic practice of timing the delivery of information based on an AI's real-time understanding of the user's immediate social or physical environment.</dd>

          <dt>Cooperative recording</dt>
          <dd>A mutual agreement to record and transcribe a dialogue so participants can capture complex spoken details, particularly during consultations with specialists like doctors or pharmacists.</dd>
        </dl>
      </div>

    </section>


    <!-- ===================================================================
         SECTION: PAST ENTRIES
         Earlier writing surfaced as cards. Same style as Multimodal work
         and the homepage Field Notes section.
         =================================================================== -->
    <section class="sg-section" id="past-entries">

      <h2 style="margin-bottom: var(--space-md);">Past entries</h2>

      <div class="writing-cards">
        {pastEntries.map(post => (
          <a href={`/writing/${post.id}`} class="writing-card">
            <div class="writing-card-image">
              {post.data.image
                ? <img src={post.data.image} alt={post.data.title} class="writing-card-img" />
                : <span class="writing-card-image-label">[ image ]</span>
              }
            </div>
            <div class="writing-card-body">
              <h3 class="writing-card-title">{post.data.title}</h3>
              <p class="writing-card-desc">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>

    </section>

  </main>

</BaseLayout>


<!-- Scoped styles for the Multimodal work cards stack and the Design concept
     glossary that follows it. Astro auto-scopes <style> blocks to this
     component, so these selectors don't leak to other pages. -->
<style>
  /* Vertical stack of FieldNoteCards. Each card is full-width; gap is the
     space between cards. */
  .multimodal-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .glossary dl {
    margin: 0;
    max-width: 72ch;
  }

  .glossary dt {
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  /* Reset the browser default 40px indent on <dd>; add comfortable spacing
     between entries and a relaxed line-height so longer definitions read well. */
  .glossary dd {
    margin: 0 0 var(--space-md);
    line-height: var(--leading-relaxed);
  }

  /* Last entry: no bottom margin, so the section padding controls spacing
     into Past entries below. */
  .glossary dd:last-of-type {
    margin-bottom: 0;
  }
</style>
