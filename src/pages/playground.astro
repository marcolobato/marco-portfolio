        <p class="sg-section-desc">
          <strong>Fraunces</strong> for display headings. <strong>Geist</strong> for everything else.
        </p>

        <!-- Type scale, mirrors the 15 named styles in the Figma library:
             Display x3, Headings x4, Body x3 here; Labels x3 + Mono x2 below. -->

        <h3 class="sg-subsection-title" id="type-display">Display · Fraunces Bold</h3>
        <div class="sg-type-scale">
          <div class="sg-type-row">
