---
// BaseLayout.astro — shared page shell for every page on the site.
// Every page passes a `title` prop; the rest of the <head> is identical everywhere.
//
// Usage:
//   <BaseLayout title="Page Title — Marco Lobato">
//     <!-- your page body content here -->
//   </BaseLayout>

// Site-wide metadata constants. Edit these here once instead of repeating
// strings across every page or every meta tag.
const SITE_URL = 'https://marcolobato.info';
const SITE_NAME = 'Marco Lobato';
const DEFAULT_OG_IMAGE = '/og-image.png';
const THEME_COLOR = '#081F5D'; // deep navy — same as the footer background

interface Props {
  title: string;
  description?: string;
  ogImage?: string;          // path to a 1200x630 image, defaults to DEFAULT_OG_IMAGE
  ogType?: 'website' | 'article'; // 'article' for blog posts and case studies
  noindex?: boolean;         // set true on pages you don't want Google to index
}

const {
  title,
  description,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Social platforms reject relative URLs in og:url, og:image, etc. Build
// absolute URLs from the current page path using new URL(path, base).
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageURL   = new URL(ogImage, SITE_URL).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/* Robots — only emit when a page opts into noindex. Pages without this
        tag default to index, follow (Google's normal behavior). */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Canonical URL — declares the official URL of this page so search
        engines don't treat trailing-slash or query-string variants as
        duplicate content. */}
    <link rel="canonical" href={canonicalURL} />

    {/* Site identity */}
    <meta name="author" content="Marco Lobato" />
    <meta name="theme-color" content={THEME_COLOR} />

    {/* Open Graph — controls link preview cards on LinkedIn, iMessage, Slack,
        Discord, WhatsApp, Bluesky, and most other platforms. */}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter Card — Twitter falls back to og:* tags for missing fields, but
        emitting these explicitly keeps older Twitter clients and platforms
        that mimic Twitter Cards rendering correctly. summary_large_image
        gives the big-image layout. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/mlobato-favicon.svg" />

    <!-- Fraunces + Geist Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,700;1,9..144,400&family=Geist+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-flash theme script — MUST be in <head> before any content renders.
         is:inline keeps this exactly as written (not bundled).
         Runs synchronously so the correct data-theme is set before the browser
         paints anything — prevents a flash of the wrong theme on load. -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || sys);
      })();
    </script>

    <!-- Scroll-position save/restore. Native browser scroll restoration
         restores too early — before lazy-loaded images and JS-rendered cards
         settle — so the saved Y position lands on a different section once
         the page reaches its full height. We disable the browser's
         restoration and run our own:
         - On `pagehide`, save the current scrollY to sessionStorage keyed by
           the page's pathname.
         - On `pageshow` AND `load`, restore from sessionStorage. Restoring
           twice covers both bfcache restores (`pageshow` fires) and full
           reloads where layout doesn't settle until images finish loading. -->
    <script is:inline>
      (function () {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        window.addEventListener('pagehide', function () {
          sessionStorage.setItem('scroll:' + location.pathname, String(window.scrollY));
        });
        function restore() {
          var saved = sessionStorage.getItem('scroll:' + location.pathname);
          if (saved === null) return;
          window.scrollTo({ top: parseInt(saved, 10), behavior: 'instant' });
        }
        window.addEventListener('pageshow', restore);
        window.addEventListener('load', restore);
      })();
    </script>
  </head>

  <body>
    <!-- Each page provides its own content via this slot -->
    <slot />
  </body>
</html>
