      <!-- ===================================================================
           SECTION: BASIS UI COMPONENTS
           Live component gallery. Toggle dark/light mode inside the preview
           using the Alpine.js button — it sets data-theme on the canvas div,
           so CSS variable overrides cascade to every component inside it.
           =================================================================== -->
      <section class="sg-section" id="basis-ui-components">
        <h2 class="sg-section-title">Basis UI Components</h2>
        <p class="sg-section-desc">
          Components from <a href="https://basis.zhengyishen.com/" class="text-link" target="_blank" rel="noopener noreferrer">Basis UI</a>. Status dots below show what's in use.
        </p>

        <!-- ── Component gallery ─────────────────────────────────────────── -->
        <h3 class="sg-subsection-title">Component gallery</h3>

        <!-- Alpine.js wrapper.
             dark initialises from the CURRENT site theme on load.
             toggle() writes back to <html> — the same element the nav ThemeToggle
             writes to — so both controls are always in sync.
             The MutationObserver keeps dark in sync when the nav toggle fires. -->
        <div
          x-data="{
            dark: document.documentElement.getAttribute('data-theme') === 'dark',
            toggle() {
              this.dark = !this.dark;
              const theme = this.dark ? 'dark' : 'light';
              document.documentElement.setAttribute('data-theme', theme);
              localStorage.setItem('theme', theme);
            }
          }"
          x-init="
            new MutationObserver(() => {
              dark = document.documentElement.getAttribute('data-theme') === 'dark';
            }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
          "
        >

          <!-- Toolbar -->
          <div class="sg-gallery-toolbar">
            <span class="sg-gallery-toolbar-label">Component preview</span>
            <button
              class="sg-gallery-toggle"
              @click="toggle()"
              :aria-label="dark ? 'Switch to light preview' : 'Switch to dark preview'"
            >
              <!-- Moon icon — shown when light, click to see dark preview -->
              <svg x-show="!dark" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <!-- Sun icon — shown when dark, click to return to light preview -->
              <svg x-show="dark" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
              <span x-text="dark ? 'Light preview' : 'Dark preview'"></span>
            </button>
          </div>

          <!-- Preview canvas — no data-theme here. Inherits from <html>, which both
               the gallery toggle and the nav ThemeToggle write to. -->
          <div class="sg-gallery-canvas">


            <!-- ── BUTTONS ──────────────────────────────────────────────── -->
            <div class="sg-gallery-block" id="basis-button">
              <p class="sg-gallery-block-title">Button — <code>src/components/ui/forms/Button.astro</code></p>
              <p class="sg-gallery-block-status sg-gallery-block-status--used">Used in writing pages for the lightbox close button.</p>

              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: 0 0 var(--space-2xs);">Variants</p>
              <div class="sg-gallery-row">
                <!-- default: bg-primary (navy) / text-primary-foreground (white) -->
                <BasisButton>Default</BasisButton>
                <!-- secondary: bg-secondary (navy-100) / text-secondary-foreground -->
                <BasisButton variant="secondary">Secondary</BasisButton>
                <!-- destructive: bg-destructive / text-destructive-foreground -->
                <BasisButton variant="destructive">Destructive</BasisButton>
                <!-- outline: border-border bg-background — hover shows accent -->
                <BasisButton variant="outline">Outline</BasisButton>
                <!-- ghost: transparent — hover bg-accent, text-accent-foreground -->
                <BasisButton variant="ghost">Ghost</BasisButton>
                <!-- link: text-primary with underline on hover -->
                <BasisButton variant="link">Link</BasisButton>
              </div>

              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: var(--space-md) 0 var(--space-2xs);">Sizes</p>
              <div class="sg-gallery-row">
                <BasisButton size="sm">Small</BasisButton>
                <BasisButton size="md">Medium</BasisButton>
                <BasisButton size="lg">Large</BasisButton>
              </div>

              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: var(--space-md) 0 var(--space-2xs);">States</p>
              <div class="sg-gallery-row">
                <BasisButton disabled>Disabled</BasisButton>
                <BasisButton variant="outline" disabled>Outline disabled</BasisButton>
              </div>

              <p style="font-size: var(--text-xs); color: hsl(var(--muted-foreground)); margin: var(--space-md) 0 var(--space-2xs);">Note: ghost and outline buttons show <code>--accent</code> (Lemon) on hover</p>
            </div>


            <!-- ── CARD ────────────────────────────────────────────────── -->
            <div class="sg-gallery-block" id="basis-card">
              <p class="sg-gallery-block-title">Card — <code>src/components/ui/display/card/</code></p>
              <p class="sg-gallery-block-status sg-gallery-block-status--unused">Available, not currently in use.</p>
              <div style="display: flex; flex-wrap: wrap; gap: var(--space-lg); align-items: flex-start;">

                <!-- Default variant — uses --card (white / dark surface) -->
                <Card padding="lg" style="width: 220px;">
                  <CardHeader>
                    <BasisText variant="card-title">Default card</BasisText>
                    <BasisText variant="card-subtitle">With header / content / footer</BasisText>
                  </CardHeader>
                  <CardContent>
                    <BasisText variant="card-description">Body content lives here. Background uses <code>--card</code>.</BasisText>
                  </CardContent>
                  <CardFooter>
                    <BasisButton size="sm">Action</BasisButton>
                    <BasisButton size="sm" variant="ghost">Cancel</BasisButton>
                  </CardFooter>
                </Card>

