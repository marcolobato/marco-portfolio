---
/**
 * WorkCard.astro
 * 
 * A flip card component for the Selected Work section.
 * Card front shows a static image thumbnail with pattern label and title.
 * Card back shows case detail text, rendered from props.
 * Expand button opens the lightbox (handled by parent page JS).
 * 
 * USAGE:
 * <WorkCard
 *   id="setup"
 *   pattern="Learnable Efficiency"
 *   title="Android Setup Wizard, Pixel"
 *   backHeading="Efficient from the first screen"
 *   backParagraphs={[
 *     'First paragraph of case detail...',
 *     'Second paragraph of case detail...'
 *   ]}
 *   stats={[
 *     { value: 'First OS', desc: 'with voice setup' },
 *     { value: 'Adopted', desc: 'by other Android OEMs' }
 *   ]}
 *   image="/images/work/setup-wizard-thumb.png"
 *   imageAlt="Android Setup Wizard showing numbered Wi-Fi networks"
 *   channels={[
 *     { type: 'voice', label: 'voice' },
 *     { type: 'screen', label: 'screen' }
 *   ]}
 *   lightboxDesc="Numbered labels teach efficient voice interaction from the first screen."
 * />
 */

interface Stat {
  value: string;
  desc: string;
}

interface Channel {
  type: string;  // voice | screen | camera | gesture | gaze
  label: string;
}

interface Props {
  id: string;
  pattern: string;
  title: string;
  backHeading: string;
  backParagraphs: string[];
  stats: Stat[];
  image: string;
  imageAlt?: string;
  channels: Channel[];
  lightboxDesc: string;
  eager?: boolean;
  /* Optional. When set, the back of the card shows a link to the full case
     study. Cards without it stay self-contained, exactly as before. */
  href?: string;
}

const {
  id,
  pattern,
  title,
  backHeading,
  backParagraphs,
  stats,
  image,
  imageAlt = '',
  channels,
  lightboxDesc,
  eager = false,
  href,
} = Astro.props;
---

<div
  class="work-card"
  data-card-id={id}
  data-pattern={pattern}
  data-title={title}
  data-lightbox-desc={lightboxDesc}
  data-channels={JSON.stringify(channels)}
>
  <div class="work-card__inner">

    {/* ── FRONT ── */}
    <div class="work-card__front">
      <div class="work-card__image-area">
        {/* Both controls sit in one group. Splitting them across opposite
            corners implied they belonged to different things. Flip is rightmost
            so it stays in exactly the same place when the card turns over and
            the expand button disappears. */}
        <div class="work-card__actions">
          <button
            class="work-card__btn work-card__btn--expand"
            data-action="expand"
            aria-label={`Enlarge the image for ${title}`}
            title="Enlarge image"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/>
              <path d="m20 20-3.5-3.5"/>
              <path d="M11 8v6"/>
              <path d="M8 11h6"/>
            </svg>
          </button>

          {/* Flip has no click handler of its own: the click bubbles up to the
              card, which already toggles .flipped. Being a real <button> makes
              the card keyboard-operable for the first time. */}
          <button
            class="work-card__btn work-card__btn--flip"
            aria-label={`Show case detail for ${title}`}
            title="Flip for details"
          >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
              <path d="M21 21v-5h-5"/>
            </svg>
          </button>
        </div>

        {/* Static thumbnail */}
        <img
          src={image}
          alt={imageAlt}
          class="work-card__thumb"
          loading={eager ? 'eager' : 'lazy'}
        />

        {/* Channel strip */}
        <div class="work-card__channels">
          <span class="work-card__channels-label">Channels:</span>
          {channels.map((ch) => (
            <div class="work-card__channel">
              <span class={`work-card__channel-dot work-card__channel-dot--${ch.type}`} />
              <span class="work-card__channel-label">{ch.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="work-card__footer">
        <div class="work-card__pattern">{pattern}</div>
        <div class="work-card__title">{title}</div>
      </div>
    </div>

    {/* ── BACK ── */}
    <div class="work-card__back">
      {/* No expand button here. The lightbox only ever showed the thumbnail and
          a one-line caption, which is LESS than the case detail already on this
          face, so "expand" was returning less information than it promised.
          Same .work-card__actions wrapper as the front, so the flip button lands
          in the identical position when the card turns. */}
      <div class="work-card__actions">
        <button
          class="work-card__btn work-card__btn--flip"
          aria-label={`Return to ${title}`}
          title="Flip back"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
            <path d="M21 21v-5h-5"/>
          </svg>
        </button>
      </div>
      <div class="work-card__back-label">Case Detail</div>
      <h3 class="work-card__back-heading">{backHeading}</h3>
      <div class="work-card__back-body">
        {backParagraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="work-card__back-result">
        <div class="work-card__result-label">Outcome</div>
        <div class="work-card__result-stats">
          {stats.map((s) => (
            <div class="work-card__stat">
              <div class="work-card__stat-value">{s.value}</div>
              <div class="work-card__stat-desc">{s.desc}</div>
            </div>
          ))}
        </div>
      </div>
      {href && (
        <a class="work-card__back-link" href={href} data-action="link">
          Read the full case study
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      )}
    </div>

  </div>
</div>

<style>
  /* ═══════════════════════════════════════
     WorkCard — Scoped Styles
     Uses site CSS variables from global theme:
       --color-deep-navy
       --color-lemon-sorbet
       --color-royal-blue
       --color-citrine-green
       --color-slate-gray
       --color-dark-charcoal
     
     Adjust variable names below to match your
     site's actual CSS variable naming convention.
     ═══════════════════════════════════════ */

  .work-card {
    perspective: 1200px;
    height: 500px;
    cursor: pointer;
    /* Lift transition — mirrors the writing-card hover behavior */
    transition: transform 0.2s ease;
  }

  /* Subtle lift on hover — same as writing cards */
  .work-card:hover {
    transform: translateY(-2px);
  }

  .work-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
    /* Safari requires the -webkit- prefix for 3D transforms to work correctly */
    -webkit-transform-style: preserve-3d;
  }

  .work-card.flipped .work-card__inner {
    transform: rotateY(180deg);
  }

  .work-card__front,
  .work-card__back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 14px;
    overflow: hidden;
    will-change: transform;
  }

  /* ── Front ── */
  .work-card__front {
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-surface);
    display: flex;
    flex-direction: column;
    box-shadow: none;
    /* Shadow transition — shadow appears on hover, same as writing cards */
    transition: box-shadow 0.2s ease;
  }

  /* Shadow appears on hover — same navy-tinted value as .writing-card:hover */
  .work-card:hover .work-card__front {
    box-shadow: 0 4px 24px rgba(8, 31, 93, 0.08);
  }

  .work-card__image-area {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: var(--color-card-anim-bg, #f8f8f5);
    border-bottom: 1px solid var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .work-card__thumb {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    border-radius: 8px;
  }

  /* ── Buttons ── */
  /* One action row, top-right, on both faces. On the back the inner + back
     rotations combine to 360deg, so right: 10px still lands on the visual
     right. */
  .work-card__actions {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    gap: 6px;
    z-index: 20;
  }

  .work-card__btn {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: hsl(0 0% 100% / 0.85);
    backdrop-filter: blur(4px);
    border: 1px solid var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 1px 4px hsl(var(--deep-navy-hsl, 224 83% 20%) / 0.08);
  }

  .work-card__btn:hover {
    background: #fff;
    transform: scale(1.08);
  }

  /* The card was a <div> with a click handler, so it could not be operated by
     keyboard at all. These are real buttons now, so they need a visible focus
     ring.

     box-shadow, NOT outline. These buttons sit inside a preserve-3d /
     backface-visibility context, where each card face is composited as its own
     layer and outlines frequently fail to paint. box-shadow renders reliably.
     The dark-mode equivalent lives in global.css because the dark override for
     .work-card__btn sets box-shadow at a specificity this scoped rule cannot
     beat. */
  .work-card__btn:focus-visible {
    box-shadow: 0 0 0 3px var(--color-royal-blue);
  }

  .work-card__btn svg {
    width: 14px;
    height: 14px;
    /* Always dark navy — readable against the white/frosted button in both modes.
       --color-navy is locked to #081F5D and never flips in dark mode (see global.css). */
    color: var(--color-navy);
  }

  /* ── Channel Strip ── */
  .work-card__channels {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    /* min-height, not height: a long label like "screen reader" pushed the strip
       past 26px and got clipped. Wrapping to a second line is better than cutting
       a word in half. */
    min-height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
    padding: 4px 8px;
    background: hsl(0 0% 100% / 0.7);
    backdrop-filter: blur(6px);
    border-top: 1px solid var(--color-surface);
  }

  .work-card__channel {
    display: flex;
    align-items: center;
    gap: 3px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .work-card__channel-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .work-card__channel-dot--voice  { background: var(--color-royal-blue, #1350C5); }
  .work-card__channel-dot--screen { background: var(--color-citrine-green, #CCD418); }
  .work-card__channel-dot--camera { background: #8b5cf6; }
  .work-card__channel-dot--gesture { background: var(--color-dark-charcoal, #3C2F39); }
  .work-card__channel-dot--gaze   { background: #e07b3a; }

  /* Assistive input methods share one color on purpose. Keyboard, screen reader
     and switch are one category, not three unrelated channels, and eight distinct
     dot colors is more than a 5px circle can carry. Uses a real token so it flips
     correctly in dark mode (#1040A8 light, #6090E0 dark). */
  .work-card__channel-dot--keyboard,
  .work-card__channel-dot--screenreader,
  .work-card__channel-dot--switch { background: var(--color-royal-blue); }

  .work-card__channel-label {
    color: var(--color-slate);
  }

  .work-card__channels-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-slate);
    margin-right: 0.4rem;
    padding-right: 0.6rem;
    border-right: 1px solid var(--color-surface);
  }

  /* ── Footer ── */
  .work-card__footer {
    padding: 1rem 1.25rem;
    background: hsl(var(--card));
  }

  .work-card__pattern {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-royal-blue);
    margin-bottom: 0.1rem;
  }

  .work-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    margin-bottom: 0.3rem;
    line-height: var(--leading-normal);
  }

  /* ── Back ── */
  .work-card__back {
    background: hsl(var(--card));
    border: 1px solid var(--color-surface);
    transform: rotateY(180deg);
    padding: 1.4rem 1.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: none;
    transition: box-shadow 0.2s ease;
  }

  /* Shadow on hover — matches front face and writing cards */
  .work-card:hover .work-card__back {
    box-shadow: 0 4px 24px rgba(8, 31, 93, 0.08);
  }

  .work-card__back-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-royal-blue);
    margin-bottom: 0.6rem;
  }

  .work-card__back-heading {
    /* was a raw 1.05rem, which existed nowhere else in the type scale */
    font-size: var(--text-base);
    font-weight: 500;
    color: hsl(var(--foreground));
    margin-bottom: 0.85rem;
    line-height: 1.3;
  }

  .work-card__back-body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-charcoal);
    flex: 1;
    overflow-y: auto;
    /* Prevent scrollbar from causing layout shift */
    scrollbar-width: thin;
    scrollbar-color: var(--color-surface) transparent;
  }

  .work-card__back-body p {
    margin-bottom: 0.7rem;
  }

  .work-card__back-result {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-surface);
  }

  .work-card__result-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-royal-blue);
    margin-bottom: 0.4rem;
  }

  /* Stacked, not side by side. These read as sentences, not metrics, and a row
     of columns crushed the longer ones. */
  .work-card__result-stats {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    line-height: var(--leading-normal);
  }

  /* Value and description render as one plain sentence: same size, same weight,
     same colour. The split exists in the props so stats stay structured to
     author, not so they look different. Full foreground gives the strongest
     contrast in both themes, near-black on light and near-white on dark.

     No ::after space here. The newline between the two divs in the template
     already renders as a single space once they are inline, and it survives the
     production build. Adding a non-breaking space on top of it produced a
     visible double space. */
  .work-card__stat-value,
  .work-card__stat-desc {
    display: inline;
    font-size: var(--text-sm);
    color: hsl(var(--foreground));
  }

  .work-card__back-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    margin-top: 0.8rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-royal-blue);
    text-decoration: none;
  }

  .work-card__back-link:hover { text-decoration: underline; }

  .work-card__back-link svg { width: 13px; height: 13px; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .work-card {
      height: 470px;
    }
  }

  /* ── Dark mode ──
     All dark mode overrides live in global.css (not here) to avoid
     Astro scoped-style specificity issues with [data-theme="dark"]. */
</style>

<script>
  // Flip on click (but not when expand button is clicked)
  document.querySelectorAll('.work-card').forEach(card => {
    // backface-visibility hides a face visually but leaves it in the tab order.
    // Now that both faces carry real buttons, a keyboard user would otherwise
    // tab into controls they cannot see. `inert` removes the hidden face from
    // both the tab order and the accessibility tree.
    const front = card.querySelector('.work-card__front') as HTMLElement;
    const back  = card.querySelector('.work-card__back') as HTMLElement;

    function syncInert() {
      const flipped = card.classList.contains('flipped');
      if (front) front.inert = flipped;
      if (back)  back.inert  = !flipped;
    }
    syncInert();

    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      // Expand button and the case-study link both handle their own click.
      // Without this the card would flip instead of navigating.
      if (target.closest('[data-action="expand"]')) return;
      if (target.closest('[data-action="link"]')) return;
      card.classList.toggle('flipped');
      syncInert();
    });
  });

  // Expand button dispatches custom event for parent to handle
  document.querySelectorAll('[data-action="expand"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (e.target as HTMLElement).closest('.work-card');
      const id = card?.getAttribute('data-card-id');
      if (id) {
        // Pass the button itself, so the lightbox can hand focus back to the
        // exact control the user pressed rather than dumping them at the top
        // of the document.
        window.dispatchEvent(new CustomEvent('work-card:expand', { detail: { id, trigger: btn } }));
      }
    });
  });
</script>
