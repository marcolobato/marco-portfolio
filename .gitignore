# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
# macOS Finder duplicates (files like "foo 2.md", "foo 3.png")
* 2.*
* 3.*
* copy.*
* copy 2.*

# jetbrains setting folder
.idea/

# archives — exports, design system bundles, etc. don't belong in the repo
*.zip
*.tar
*.tar.gz

# scratch / local-only working files
# (anything matching scratch-*, *.local.*, or inside a /scratch/ folder is ignored)
scratch-*
*.local.*
/scratch/
